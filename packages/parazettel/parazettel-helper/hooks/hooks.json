{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "py ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start-briefing.py",
            "timeout": 10,
            "statusMessage": "Loading parazettel vault briefing..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt-recall.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "py ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/extract-chat-ideas.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
